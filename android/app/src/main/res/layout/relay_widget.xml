<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="0dp">
    <LinearLayout android:id="@+id/widget_normal" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/widget_error" android:layout_width="match_parent" android:layout_height="18dp" android:background="#EEEBFC" android:textColor="#9D3424" android:textSize="11sp" android:gravity="center" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:visibility="gone"/>
        <LinearLayout android:id="@+id/widget_session_summary" android:visibility="gone" android:layout_width="match_parent" android:layout_height="20dp" android:orientation="horizontal" android:background="#EEEBFC">
            <TextView android:id="@+id/widget_status" android:layout_width="18dp" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:text="!" android:textColor="#24232C" android:textSize="12sp" android:textStyle="bold" android:visibility="gone"/>
            <TextView android:id="@+id/widget_timer_label" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="start|center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" android:includeFontPadding="false" android:textColor="#24232C" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
            <FrameLayout android:id="@+id/widget_timer_value" android:layout_width="wrap_content" android:layout_height="match_parent">
                <Chronometer android:id="@+id/widget_clock" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:textColor="#24232C" android:textSize="14sp" android:visibility="gone"/>
                <TextView android:id="@+id/widget_time_static" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:includeFontPadding="false" android:text="00:00:00" android:textColor="#24232C" android:textSize="14sp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_start_actions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <Button android:id="@+id/widget_work" android:background="@drawable/widget_work_button" android:backgroundTint="@null" android:text="Work Time" android:textColor="#FFFFFF" android:textSize="14sp" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:stateListAnimator="@null" android:elevation="0dp" android:translationZ="0dp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/widget_baby" android:background="@drawable/widget_baby_button" android:backgroundTint="@null" android:text="Baby Time" android:textColor="#24232C" android:textSize="14sp" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:stateListAnimator="@null" android:elevation="0dp" android:translationZ="0dp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_session_actions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/widget_interruption" android:background="@drawable/widget_interruption_button" android:backgroundTint="@null" android:text="Interruption" android:textColor="#24232C" android:textSize="14sp" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:stateListAnimator="@null" android:elevation="0dp" android:translationZ="0dp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/widget_change_baby" android:background="@drawable/widget_baby_button" android:backgroundTint="@null" android:text="Change baby" android:textColor="#24232C" android:textSize="14sp" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:stateListAnimator="@null" android:elevation="0dp" android:translationZ="0dp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:visibility="gone"/>
            <Button android:id="@+id/widget_end" android:background="@drawable/widget_work_button" android:backgroundTint="@null" android:text="End" android:textColor="#FFFFFF" android:textSize="14sp" android:textAllCaps="false" android:padding="0dp" android:minWidth="0dp" android:minHeight="0dp" android:maxLines="2" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="11sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:stateListAnimator="@null" android:elevation="0dp" android:translationZ="0dp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/relay_widget_picker"/>
</LinearLayout>
